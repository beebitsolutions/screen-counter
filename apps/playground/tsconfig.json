{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "incremental": true,
    "allowJs": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/chromium/types/**/*.ts",
    ".next-e2e/limit-amber/types/**/*.ts",
    ".next-e2e/limit-red/types/**/*.ts",
    ".next-e2e/show-never/types/**/*.ts",
    ".next-solo/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-e2e/limit-green/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
